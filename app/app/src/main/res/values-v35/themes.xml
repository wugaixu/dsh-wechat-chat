<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主界面也退出边到边：让 adjustResize 正常缩 WebView，输入条不被键盘遮挡 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#f7f7f7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#ededed</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Android 15+ 强制边到边显示，裁剪界面需退出边到边，避免工具栏按钮压到状态栏下 -->
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
